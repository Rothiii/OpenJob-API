# Environment
NODE_ENV=development

# Database — the same database the API writes to (schema owned by openjob-api)
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# RabbitMQ — must point at the same broker as the API.
# AMQP_URL is optional and overrides the parts below when set.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
AMQP_URL=

# Mail — for Gmail, MAIL_PASSWORD must be an App Password, not the account one
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
