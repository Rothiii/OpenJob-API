{
  "name": "openjob-api",
  "version": "1.0.0",
  "description": "OpenJob RESTful API \u2014 submission Fundamental Back-End dengan JavaScript",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src migrations",
    "migrate": "node-pg-migrate",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:reset": "node-pg-migrate down 0 && node-pg-migrate up"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rothiii/OpenJob-API.git"
  },
