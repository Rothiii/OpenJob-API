    "url": "https://github.com/Rothiii/OpenJob-API/issues"
  },
  "homepage": "https://github.com/Rothiii/OpenJob-API#readme",
  "dependencies": {
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14"
  }
}
